#: ui-tui/rc-tui.c:696
msgid "Playback"
msgstr "播放"

#: ui-tui/rc-tui.c:697
msgid "  Enter      Play the selected track (or open the source)"
msgstr "  Enter      播放選取的曲目（或開啟來源）"

#: ui-tui/rc-tui.c:698
msgid "  Space      Play / pause            s   Stop"
msgstr "  Space      播放 / 暫停             s   停止"

#: ui-tui/rc-tui.c:699
msgid "  n / p      Next / previous track"
msgstr "  n / p      下一首 / 上一首"

#: ui-tui/rc-tui.c:700
msgid "  Left/Right Seek backward / forward (5 seconds)"
msgstr "  Left/Right 倒轉 / 快轉（5 秒）"

#: ui-tui/rc-tui.c:701
msgid "  + / -      Volume up / down"
msgstr "  + / -      調高 / 調低音量"

#: ui-tui/rc-tui.c:702
msgid "  r          Cycle repeat mode (off, list, all, track)"
msgstr "  r          切換重複模式（關、清單、全部、單曲）"

#: ui-tui/rc-tui.c:703
msgid "  z          Toggle random mode"
msgstr "  z          開關隨機模式"

#: ui-tui/rc-tui.c:704
msgid "  e          Toggle equalizer        E   Next equalizer preset"
msgstr "  e          開關等化器              E   下一個等化器預設集"

#: ui-tui/rc-tui.c:705
msgid "Library and playlists"
msgstr "音樂庫和播放清單"

#: ui-tui/rc-tui.c:706
msgid "  Tab        Switch between sources and tracks"
msgstr "  Tab        在來源和曲目之間切換"

#: ui-tui/rc-tui.c:707
msgid "  g          Cycle library grouping (none, artist, album)"
msgstr "  g          切換音樂庫分組（不分組、演出者、專輯）"

#: ui-tui/rc-tui.c:708
msgid "  a          Add a file, CUE sheet, playlist file or folder"
msgstr "  a          加入檔案、CUE 表、播放清單檔案或資料夾"

#: ui-tui/rc-tui.c:709
msgid "  c          Cancel the pending imports"
msgstr "  c          取消等待中的匯入"

#: ui-tui/rc-tui.c:710
msgid "  A          Add the selected track to a playlist"
msgstr "  A          將選取的曲目加入播放清單"

#: ui-tui/rc-tui.c:711
msgid "  d / Del    Remove the selected track"
msgstr "  d / Del    移除選取的曲目"

#: ui-tui/rc-tui.c:712
msgid "  J / K      Move the selected track or playlist down / up"
msgstr "  J / K      下移 / 上移選取的曲目或播放清單"

#: ui-tui/rc-tui.c:713
msgid "  N / R / D  New / rename / delete playlist"
msgstr "  N / R / D  新增 / 重新命名 / 刪除播放清單"

#: ui-tui/rc-tui.c:714
msgid "  L / W      Load a playlist file / save the track list to a file"
msgstr "  L / W      載入播放清單檔案 / 將曲目清單儲存到檔案"

#: ui-tui/rc-tui.c:715
msgid "  u / U      Refresh metadata of the track / all tracks"
msgstr "  u / U      重新整理該曲目 / 全部曲目的中繼資料"

#: ui-tui/rc-tui.c:716
msgid "  M          Remove items whose files are missing"
msgstr "  M          移除檔案遺失的項目"

#: ui-tui/rc-tui.c:717
msgid "  l          Toggle lyric display"
msgstr "  l          開關歌詞顯示"

#: ui-tui/rc-tui.c:718
msgid "  q          Quit                    ?   Close this help"
msgstr "  q          結束                    ?   關閉說明"

