"g:分组  Tab:切换  ?:帮助  q:退出"

#: ui-tui/rc-tui.c:729
msgid "Playback"
msgstr "播放"

#: ui-tui/rc-tui.c:730
msgid "  Enter      Play the selected track (or open the source)"
msgstr "  Enter      播放选中的曲目（或打开来源）"

#: ui-tui/rc-tui.c:731
msgid "  Space      Play / pause            s   Stop"
msgstr "  Space      播放 / 暂停             s   停止"

#: ui-tui/rc-tui.c:732
msgid "  n / p      Next / previous track"
msgstr "  n / p      下一首 / 上一首"

#: ui-tui/rc-tui.c:733
msgid "  Left/Right Seek backward / forward (5 seconds)"
msgstr "  Left/Right 快退 / 快进（5 秒）"

#: ui-tui/rc-tui.c:734
msgid "  + / -      Volume up / down"
msgstr "  + / -      增大 / 减小音量"

#: ui-tui/rc-tui.c:735
msgid "  r          Cycle repeat mode (off, list, all, track)"
msgstr "  r          切换重复模式（关、列表、全部、单曲）"

#: ui-tui/rc-tui.c:736
msgid "  z          Toggle random mode"
msgstr "  z          开关随机模式"

#: ui-tui/rc-tui.c:737
msgid "  e          Toggle equalizer        E   Next equalizer preset"
msgstr "  e          开关均衡器              E   下一个均衡器预设"

#: ui-tui/rc-tui.c:738
msgid "Library and playlists"
msgstr "音乐库和播放列表"

#: ui-tui/rc-tui.c:739
msgid "  Tab        Switch between sources and tracks"
msgstr "  Tab        在来源和曲目之间切换"

#: ui-tui/rc-tui.c:740
msgid "  g          Cycle library grouping (none, artist, album)"
msgstr "  g          切换音乐库分组（不分组、艺术家、专辑）"

#: ui-tui/rc-tui.c:741
msgid "  a          Add a file, CUE sheet, playlist file or folder"
msgstr "  a          添加文件、CUE 表、播放列表文件或文件夹"

#: ui-tui/rc-tui.c:742
msgid "  c          Cancel the pending imports"
msgstr "  c          取消等待中的导入"

#: ui-tui/rc-tui.c:743
msgid "  A          Add the selected track to a playlist"
msgstr "  A          将选中的曲目添加到播放列表"

#: ui-tui/rc-tui.c:744
msgid "  d / Del    Remove the selected track"
msgstr "  d / Del    移除选中的曲目"

#: ui-tui/rc-tui.c:745
msgid "  J / K      Move the selected track or playlist down / up"
msgstr "  J / K      下移 / 上移选中的曲目或播放列表"

#: ui-tui/rc-tui.c:746
msgid "  N / R / D  New / rename / delete playlist"
msgstr "  N / R / D  新建 / 重命名 / 删除播放列表"

#: ui-tui/rc-tui.c:747
msgid "  L / W      Load a playlist file / save the track list to a file"
msgstr "  L / W      载入播放列表文件 / 将曲目列表保存到文件"

#: ui-tui/rc-tui.c:748
msgid "  u / U      Refresh metadata of the track / all tracks"
msgstr "  u / U      刷新该曲目 / 全部曲目的元数据"

#: ui-tui/rc-tui.c:749
msgid "  M          Remove items whose files are missing"
msgstr "  M          移除文件丢失的项目"

#: ui-tui/rc-tui.c:750
msgid "  l          Toggle lyric display"
msgstr "  l          开关歌词显示"

#: ui-tui/rc-tui.c:751
msgid "  m          Toggle MPRIS (control by the desktop)"
msgstr "  m          开关 MPRIS（由桌面控制）"

#: ui-tui/rc-tui.c:752
msgid "  q          Quit                    ?   Close this help"
msgstr "  q          退出                    ?   关闭帮助"

