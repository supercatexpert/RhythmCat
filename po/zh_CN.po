#: ui-tui/rc-tui.c:720
msgid ""
"Enter:Play  Space:Pause  n/p:Next/Prev  </>:Seek  +/-:Volume  a:Add  "
"g:Group  Tab:Switch  ?:Help  q:Quit"
msgstr ""
